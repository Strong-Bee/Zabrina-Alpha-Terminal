# =============================================================================
# Zabrina Alpha Terminal — Environment Template
# =============================================================================
# Fokus produk: cryptocurrency trading, market data, dan Solana meme coin research.
#
# Setup lokal:
#   1. Salin file ini menjadi .env.local
#   2. Jalankan: npm ci && npm run dev
#
# Konfigurasi wajib saat ini: tidak ada.
# Integrasi market data publik (Binance dan DEX Screener) saat ini tidak
# memerlukan API key untuk alur dasar. Endpoint provider yang belum dikonfigurasi
# melalui environment tetap ditentukan oleh kode aplikasi.
#
# Jangan masukkan API key, token, seed phrase, atau private key ke repository.
# .env.local seharusnya tetap lokal dan tidak di-commit.
# Jangan gunakan NEXT_PUBLIC_ untuk nilai rahasia: variabel tersebut dapat
# diekspos ke browser.
# =============================================================================

# Nonaktifkan telemetry Next.js pada lingkungan lokal/CI (opsional).
NEXT_TELEMETRY_DISABLED=1

# =============================================================================
# OPSIONAL — deployment
# =============================================================================
# Atur URL publik aplikasi jika/ketika kode atau platform deployment
# memerlukan base URL eksplisit. Variabel ini belum menjadi konfigurasi wajib.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# OPSIONAL — provider API (future integrations)
# =============================================================================
# Jangan aktifkan variabel di bawah hanya dengan menambahkannya ke file ini.
# Kode aplikasi harus terlebih dahulu membaca dan memvalidasi variabel terkait.
# Gunakan hanya credential dari provider yang benar-benar diintegrasikan.
#
# Contoh placeholder untuk pengembangan berikutnya:
# BINANCE_API_BASE_URL=https://api.binance.com
# DEX_SCREENER_API_BASE_URL=https://api.dexscreener.com
# SOLANA_RPC_URL=
# SOLANA_RPC_API_KEY=
#
# Untuk provider yang memerlukan API key, simpan key di server-side saja.
# Jangan gunakan NEXT_PUBLIC_BINANCE_API_KEY, NEXT_PUBLIC_SOLANA_RPC_API_KEY,
# atau variabel NEXT_PUBLIC_* lain untuk secret.
#
# Jika variabel belum dibaca oleh kode aplikasi, mengisinya tidak akan
# mengubah endpoint atau perilaku aplikasi.


# =============================================================================
# NVIDIA NIM — AI analysis for Crypto Screener and Market Radar (server-side only)
# Obtain an API key from NVIDIA NIM and configure it in local .env.local or
# deployment environment settings. Never use NEXT_PUBLIC_ for these secrets.
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Optional: public Binance market-data base URL (no secret required).
BINANCE_API_BASE_URL=https://data-api.binance.vision
